{
  "sourceRoots": {
    "src": "production",
    "tests": "test",
    "scripts/harness": "development",
    "scripts/service": "development"
  },
  "developmentDependencies": {
    "scripts/harness": ["scripts/harness"],
    "scripts/service": [
      "scripts/service",
      "src/auth/config.ts",
      "src/conversations/config.ts",
      "src/conversations/schema.ts",
      "src/providers/config.ts",
      "src/providers/schema.ts",
      "src/providers/store.ts",
      "src/providers/contracts.ts"
    ]
  },
  "documentRoots": ["README.md", "AGENTS.md", "docs"],
  "privateRoots": [".work", ".runtime"],
  "generatedRoots": ["node_modules", "dist", "coverage", ".git"],
  "configurationFiles": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "tsconfig.build.json",
    "eslint.config.mjs",
    "vitest.config.ts",
    "harness.config.json",
    ".gitignore",
    ".prettierignore",
    ".prettierrc.json",
    ".node-version",
    ".npmrc",
    "cordis.patch.yml",
    ".editorconfig"
  ],
  "taskDocuments": [
    {
      "identity": "docs/prd-ai-drama-foundation.md",
      "kind": "prd",
      "path": "docs/tasks/ai-drama-foundation/prd.md"
    },
    {
      "identity": "docs/architecture-ai-drama-foundation.md",
      "kind": "design",
      "path": "docs/tasks/ai-drama-foundation/design.md"
    },
    {
      "identity": "docs/tasks/auth-rate-limit-redis/prd.md",
      "kind": "prd",
      "path": "docs/tasks/auth-rate-limit-redis/prd.md"
    },
    {
      "identity": "docs/tasks/conversation-service/prd.md",
      "kind": "prd",
      "path": "docs/tasks/conversation-service/prd.md"
    },
    {
      "identity": "docs/tasks/onelink-integration/prd.md",
      "kind": "prd",
      "path": "docs/tasks/onelink-integration/prd.md"
    }
  ]
}

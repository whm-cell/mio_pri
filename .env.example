# Public template only. `pnpm env:init` creates private .env and .env.test (mode 600).
# Each file is complete; the test configuration never falls back to development values.
# Generated values use dev/test-specific ports, credentials, namespace and DSH directory.
MIO_ENVIRONMENT=dev
NODE_ENV=development
MIO_HOST=127.0.0.1
MIO_PORT=4310
MIO_API_TOKEN=replace-with-a-generated-secret
MIO_AUTH_BASE_URL=http://localhost:4310
MIO_AUTH_SECRET=replace-with-a-stable-secret-at-least-32-characters
MIO_AUTH_DATABASE_URL=postgresql://mio:replace-with-app-password@127.0.0.1:55432/mio_dev
MIO_AUTH_RATE_LIMIT_BACKEND=redis
MIO_AUTH_ALLOWED_ORIGINS=[]
MIO_ALLOWED_ORIGINS=[]
MIO_REDIS_URL=redis://mio:replace-with-redis-password@127.0.0.1:56379
MIO_REDIS_NAMESPACE=dev
DSH_HOME=.runtime/dev/dsh
# Local middleware secrets: 64 hexadecimal characters each; never passed to the app as admin settings.
MIO_LOCAL_POSTGRES_PORT=55432
MIO_LOCAL_REDIS_PORT=56379
MIO_LOCAL_POSTGRES_PASSWORD=replace-with-admin-password
MIO_LOCAL_DATABASE_PASSWORD=replace-with-app-password
MIO_LOCAL_REDIS_PASSWORD=replace-with-redis-password
# RabbitMQ: dev uses 56720/15680, test uses 56721/15681. Keep all generated values together.
MIO_LOCAL_RABBITMQ_PORT=56720
MIO_LOCAL_RABBITMQ_MANAGEMENT_PORT=15680
MIO_LOCAL_RABBITMQ_PASSWORD=replace-with-admin-password
MIO_LOCAL_RABBITMQ_A_PASSWORD=replace-with-a-password
MIO_LOCAL_RABBITMQ_B_PASSWORD=replace-with-b-password
RABBITMQ_URL=amqp://mio-dev-a:replace-with-a-password@127.0.0.1:56720/mio-dev
MIO_COMPUTE_BROKER_USER=mio-dev-a
MIO_COMPUTE_EXPECTED_RESULT_USER=mio-dev-b
MIO_LOCAL_COMPUTE_DIRECTORY=.runtime/dev/compute
MIO_LOCAL_COMPUTE_INSTANCE_ID=mio-dev-replace-with-64-generated-hex-characters
# MQ is provisioned independently of business enablement. For the full compute chain,
# configure this environment's separate media database and authorized COS bucket/credentials,
# migrate assets then compute, and explicitly enable A. B receives its own MQ identity.
# MIO_ASSETS_DATABASE_URL=postgresql://media-user:password@127.0.0.1:55432/media_dev
# MIO_COS_BUCKET=your-private-dev-bucket
# MIO_COS_REGION=your-region
# MIO_COS_SECRET_ID=your-authorized-secret-id
# MIO_COS_SECRET_KEY=your-authorized-secret-key
# MIO_COMPUTE_ENABLED=true
# .env.test additionally has a separate automation account/database; manual tests use mio_test.
# MIO_LOCAL_REGRESSION_PASSWORD=replace-with-regression-password
# MIO_TEST_DATABASE_URL=postgresql://mio_regression:replace-with-regression-password@127.0.0.1:55433/mio_regression_test
